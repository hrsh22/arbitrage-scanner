# Reown (WalletConnect) - Get from https://dashboard.reown.com
VITE_REOWN_PROJECT_ID=

# Backend API URL
VITE_API_URL=http://localhost:8081

# Network: "mainnet" or "testnet" (Polygon Amoy)
# Defaults to mainnet if not set
VITE_NETWORK=mainnet

# Withdrawal lock period in days (0 for instant claims)
VITE_WITHDRAWAL_LOCK_DAYS=7
