# Vault Web Environment Variables
# Copy to apps/vault-web/.env.local

# Required: WalletConnect / Reown project id
# Create one at https://cloud.reown.com/
NEXT_PUBLIC_REOWN_PROJECT_ID=vault-web-project-id

# Required: Vault API base URL (must point to running vault-api)
# Example local: http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8081
