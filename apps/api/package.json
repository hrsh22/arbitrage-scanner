    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.1",
    "ethers": "^5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.11.10",
    "@workspace/eslint-config": "workspace:*",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.39.1",
