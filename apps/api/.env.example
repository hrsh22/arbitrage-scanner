# Server
HOST=0.0.0.0
PORT=8080

# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/polymarket

# Polymarket API (optional - defaults shown)
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com

# Market fetching
MAX_EVENTS=500              # Top N most liquid events to fetch

# Polling
POLL_INTERVAL_MS=7000       # How often to poll for new data
REQUEST_TIMEOUT_MS=10000    # Request timeout
REQUEST_RETRIES=2           # Number of retries on failure

# Arbitrage detection
MIN_LIQUIDITY_USD=50        # Minimum liquidity to consider
MIN_PROFIT_PCT=0            # Minimum profit % to show (0 = all)

# AI for exclusivity checking (optional)
# Used to determine if multi-outcome events are mutually exclusive
# Only called for low-confidence heuristic results
OPENAI_API_KEY=sk-...
