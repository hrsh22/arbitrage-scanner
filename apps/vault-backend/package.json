{
  "name": "vault-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "setup-safe": "tsx src/scripts/setupSafe.ts",
    "cron:reconcile-deposits": "tsx src/cron/reconcileDeposits.ts",
    "cron:reconcile-withdrawals": "tsx src/cron/reconcileWithdrawals.ts",
    "cron:process-withdrawals": "tsx src/cron/processWithdrawals.ts",
    "cron:reconcile": "tsx src/cron/lightweightReconciler.ts",
    "reset-sync": "tsx src/scripts/resetSyncState.ts"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@polymarket/clob-client": "^5.1.2",
    "@safe-global/protocol-kit": "^6.1.2",
    "@safe-global/types-kit": "^3.0.0",
    "@workspace/network-config": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.1",
    "effect": "^3.19.15",
    "ethers": "^5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "viem": "^2.21.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.11.10",
    "@workspace/eslint-config": "workspace:*",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.39.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
