# Server
HOST=0.0.0.0
PORT=8081

# Database
VAULT_DATABASE_URL=postgresql://user:password@localhost:5432/polymarket_vault_mvp

# Polygon RPC
POLYGON_RPC_URL=https://polygon-rpc.com

# Trading wallet private key (signs Safe transactions and Polymarket orders)
# This wallet will be an owner of deployed Safes and pay gas fees
# Polymarket API credentials are derived automatically from this key
TRADING_WALLET_PRIVATE_KEY=0x...

# Vault settings
MIN_DEPOSIT_USDC=10

# Feature flags
DEPOSITS_ENABLED=true
WITHDRAWALS_ENABLED=true

# Alchemy Webhook (for deposit event detection)
# Get this from Alchemy Dashboard -> Webhooks -> Signing Key
ALCHEMY_WEBHOOK_SECRET=
