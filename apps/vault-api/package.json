{
  "name": "vault",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "worker:trading": "tsx watch src/tradingWorker.ts",
    "cron:sync-vault-analytics": "tsx src/cron/syncVaultAnalytics.ts",
    "verify:mainnet": "tsx src/scripts/verifyMainnetSetup.ts",
    "diagnose:clob-auth": "tsx src/scripts/diagnoseClobAuth.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "tsx scripts/dbReset.ts",
    "activity:backfill": "tsx scripts/backfillActivityEvents.ts"
  },
  "dependencies": {
    "@polymarket/builder-signing-sdk": "^0.0.8",
    "@polymarket/clob-client": "^5.1.2",
    "@safe-global/protocol-kit": "^6.1.2",
    "@safe-global/types-kit": "^3.0.0",
    "cookie-session": "^2.1.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.1",
    "ethers": "^5",
    "express": "^4.21.2",
    "pg": "^8.11.3",
    "postgres": "^3.4.4",
    "siwe": "^3.0.0",
    "viem": "^2.21.48",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.11.10",
    "@workspace/eslint-config": "workspace:*",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
