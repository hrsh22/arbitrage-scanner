# Vault API .env example — runtime environment surface
# 
# NOTE: Deployment-only env vars for ClosedBookBatchVault contract belong in
# contracts/scripts/.env, NOT this file.
#
# This file documents the live runtime env surface for apps/vault-api.

# =========================
# Required: Server + Session
# =========================
VAULT_PORT=8081
VAULT_SESSION_SECRET=change-me-in-production

# CORS origin for vault-web frontend
VAULT_WEB_ORIGIN=http://localhost:3000

# =========================
# Required: Database
# =========================
# Primary DB variable used by vault-api
VAULT_DATABASE_URL=postgresql://user:password@localhost:5432/vault_db

# Optional fallback accepted by db layer
# DATABASE_URL=postgresql://user:password@localhost:5432/vault_db

# Set true for hosted Postgres providers that require SSL
DATABASE_SSL=false

# =========================
# Required: Network
# =========================
# Network selection: mainnet | amoy
# Amoy ALWAYS runs in live mode (simulation not supported on testnet)
VAULT_NETWORK=mainnet

# Polygon Mainnet RPC
POLYGON_RPC_URL=https://polygon-rpc.com

# Amoy Testnet RPC (required when VAULT_NETWORK=amoy)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Optional resilience/tuning
# POLYGON_RPC_FALLBACK_URLS=https://rpc1.example,https://rpc2.example
POLYGON_RPC_TIMEOUT_MS=10000
POLYGON_RPC_RETRY_COUNT=2
POLYGON_RPC_RETRY_DELAY_MS=300

# =========================
# Required: Runtime Mode
# =========================
# simulation | live
VAULT_MODE=simulation

# CLOB Signature Type: 0=EOA, 1=Proxy, 2=Safe
VAULT_CLOB_SIGNATURE_TYPE=2

# =========================
# Required: Amoy Vault Role Keys (when VAULT_NETWORK=amoy)
# =========================
# 0x-prefixed 32-byte private keys for Amoy testnet
AMOY_VAULT_1_ALLOCATOR_NAV_KEY=0x...
AMOY_VAULT_1_SAFE_OPERATOR_KEY=0x...
AMOY_VAULT_1_TRADING_SIGNER_KEY=0x...
# Optional: explicit settler key (defaults to AMOY_VAULT_1_TRADING_SIGNER_KEY if not set)
# AMOY_VAULT_1_SETTLER_KEY=0x...

# =========================
# Required: Mainnet Vault Role Keys (when VAULT_NETWORK=mainnet)
# =========================
VAULT_1_VAULT_ADDRESS=0x5C94ABe48399D52DE3D957492aB8ad5897072883
VAULT_1_SAFE_ADDRESS=0xc340f182f7e37202aC4F81b358383BD49Bf3d03b
VAULT_1_ALLOCATOR_NAV_KEY=0x...
VAULT_1_SAFE_OPERATOR_KEY=0x...
VAULT_1_TRADING_SIGNER_KEY=0x...
VAULT_1_SETTLER_KEY=0x...

# VAULT_1_VAULT_ADDRESS must point to a helper-enabled FlatBookVaultV2 deployment
# with userAsset(), collateralOnramp(), collateralOfframp(), and USDC.e helper entrypoints.

# =========================
# Optional: Vault 1 Configuration Overrides
# =========================
VAULT_1_EPOCH_DURATION_SECONDS=3600
VAULT_1_MIN_CLAIM_THRESHOLD=100000000
VAULT_1_BALANCED_UPFRONT_BPS=0

# =========================
# Optional: Vault 1 Auto Settlement
# =========================
VAULT_1_AUTO_SETTLEMENT=true

# =========================
# Optional: Liquidity Safety Controls
# =========================
LIQUIDITY_PAUSE=false
LIQUIDITY_DRY_RUN=false
LIQUIDITY_EMERGENCY_STOP=false
LIQUIDITY_INVARIANT_TOLERANCE_USDC=1
LIQUIDITY_NAV_MAX_STALENESS_SECONDS=3600

# =========================
# Optional: Polymarket Builder Attribution
# =========================
VAULT_BUILDER_ENABLED=false
POLYMARKET_BUILDER_CODE=

# =========================
# Optional: Admin / Security
# =========================
# Secret required for forceNavUpdate admin operations
NAV_ORACLE_ADMIN_SECRET=

# Allow operator to clear emergency pause
VAULT_ALLOW_OPERATOR_OVERRIDE=false

# JSON mapping of category slugs to hour limits (legacy fallback)
# VAULT_CATEGORY_TIME_LIMITS={"crypto":1,"sports":1}

# =========================
# Optional: Alerting / PagerDuty
# =========================
PAGERDUTY_ENABLED=false
PAGERDUTY_ROUTING_KEY=

# =========================
# Optional: Alerting / Slack
# =========================
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#vault-alerts

# =========================
# Optional: Alerting / Email
# =========================
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@vault.polymarket.io
ALERT_TO_EMAILS=ops@example.com,oncall@example.com
