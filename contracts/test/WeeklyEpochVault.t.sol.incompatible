        vm.prank(attacker);
        vm.expectRevert(WeeklyEpochVault.NotRequestOwner.selector);
        vault.rolloverUnsettled(requestId);
    }

    /// @notice Test rollover reverts if not settled
    function testRolloverNotSettledReverts() public {
        uint256 shares = 100 * ONE_USDC_E;

        // Create a redemption request
        mockAsset.mint(depositor, shares);
        vm.prank(depositor);
        mockAsset.approve(address(vault), shares);
        vm.prank(depositor);
        uint256 requestId = vault.requestRedeem(shares);

        // Try to rollover before settlement
        vm.prank(depositor);
        vm.expectRevert(WeeklyEpochVault.RequestNotSettled.selector);
        vault.rolloverUnsettled(requestId);
    }

    /// @notice Test rollover event is emitted
    function testRolloverEventEmitted() public {
        uint256 shares = 100 * ONE_USDC_E;

        // Create a redemption request
        mockAsset.mint(depositor, shares);
        vm.prank(depositor);
        mockAsset.approve(address(vault), shares);
        vm.prank(depositor);
        uint256 requestId = vault.requestRedeem(shares);

        // Get request details
        WeeklyEpochVault.RedemptionRequest memory request = vault.getRequest(requestId);
        uint256 epochEnd = vault.getEpochEnd(request.epochId);

        // Warp to after epoch ends
        vm.warp(epochEnd + 1);

        // Update NAV
        vm.prank(navUpdater);
        vault.updateNAV(1000 * ONE_USDC_E);

        // Settle with partial assets
        vm.prank(settler);
        vault.settleEpoch(request.epochId, 50 * ONE_USDC_E);

        // Expect RequestRolledOver event
        vm.expectEmit(true, false, false, true);
        emit WeeklyEpochVault.RequestRolledOver(requestId, request.epochId, request.epochId + 1, 50 * ONE_USDC_E);

        vm.prank(depositor);
        vault.rolloverUnsettled(requestId);
    }
}
