    /// @notice Test claiming is idempotent (second claim is no-op)
    function testClaimIdempotentSecondClaimIsNoOp() public {
        uint256 shares = 100 * ONE_USDC_E;

        // Create a redemption request
        mockAsset.mint(depositor, shares);
        vm.prank(depositor);
        mockAsset.approve(address(vault), shares);
        vm.prank(depositor);
        uint256 requestId = vault.requestRedeem(shares);

        // Get request details
        WeeklyEpochVault.RedemptionRequest memory request = vault.getRequest(requestId);
        uint256 epochEnd = vault.getEpochEnd(request.epochId);

        // Warp to after epoch ends
        vm.warp(epochEnd + 1);

        // Update NAV
        vm.prank(navUpdater);
        vault.updateNAV(1000 * ONE_USDC_E);

        // Settle epoch
        vm.prank(settler);
        vault.settleEpoch(request.epochId, shares);

        // First claim
        vm.prank(depositor);
        vault.claim(requestId);

        // Record balance after first claim
        uint256 balanceAfterFirstClaim = mockAsset.balanceOf(depositor);

        // Second claim should be idempotent (no-op, no revert)
        vm.prank(depositor);
        vault.claim(requestId);

        // Balance should not change on second claim
        uint256 balanceAfterSecondClaim = mockAsset.balanceOf(depositor);
        assertEq(balanceAfterSecondClaim, balanceAfterFirstClaim, "Second claim should not transfer additional assets");
    }

