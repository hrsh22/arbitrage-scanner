    /// @notice Test emergency mode does NOT block claims
    function testEmergencyModeDoesNotBlockClaims() public {
        uint256 shares = 100 * ONE_USDC_E;

        // Create a redemption request
        mockAsset.mint(depositor, shares);
        vm.prank(depositor);
        mockAsset.approve(address(vault), shares);
        vm.prank(depositor);
        uint256 requestId = vault.requestRedeem(shares);

        // Get request details
        WeeklyEpochVault.RedemptionRequest memory request = vault.getRequest(requestId);
        uint256 epochEnd = vault.getEpochEnd(request.epochId);

        // Warp to after epoch ends
        vm.warp(epochEnd + 1);

        // Update NAV
        vm.prank(navUpdater);
        vault.updateNAV(1000 * ONE_USDC_E);

        // Settle epoch
        vm.prank(settler);
        vault.settleEpoch(request.epochId, shares);

        // Enable emergency mode AFTER settlement
        vm.prank(admin);
        vault.setEmergencyMode(true);

        // Claim should still succeed (emergency mode doesn't block settled claims)
        uint256 balanceBefore = mockAsset.balanceOf(depositor);
        vm.prank(depositor);
        vault.claim(requestId);
        uint256 balanceAfter = mockAsset.balanceOf(depositor);

        assertEq(balanceAfter - balanceBefore, shares, "Should be able to claim during emergency mode");
    }

