    /// @notice Test cancelled requests are not included in settlement
    function testCancelledRequestsNotIncludedInSettlement() public {
        uint256 shares = 100 * ONE_USDC_E;
        
        mockAsset.mint(depositor, shares);
        vm.prank(depositor);
        mockAsset.approve(address(vault), shares);
        vm.prank(depositor);
        uint256 requestId = vault.requestRedeem(shares);
        
        // Cancel the request
        vm.prank(depositor);
        vault.cancelRedemption(requestId);
        
        // Verify cancellation
        WeeklyEpochVault.RedemptionRequest memory request = vault.getRequest(requestId);
        assertEq(uint256(request.status), uint256(WeeklyEpochVault.RequestStatus.Cancelled), "Should be cancelled");
        
        // Move to next epoch
        uint256 currentEpoch = vault.getCurrentEpoch();
        uint256 epochEnd = vault.getEpochEnd(currentEpoch);
        vm.warp(epochEnd + 1);
        
        vm.prank(navUpdater);
        vault.updateNAV(1000 * ONE_USDC_E);
        
        // Settlement should revert because no pending requests
        vm.prank(settler);
        vm.expectRevert(WeeklyEpochVault.NoPendingRequests.selector);
        vault.settleEpoch(currentEpoch, 100 * ONE_USDC_E);
    }

    // ============================================================================
    // CLAIM TESTS (Task 8)
    // ============================================================================

    /// @notice Test claiming a settled request transfers assets
    function testClaimSettledRequestTransfersAssets() public {
        uint256 shares = 100 * ONE_USDC_E;

        // Create a redemption request
        mockAsset.mint(depositor, shares);
        vm.prank(depositor);
        mockAsset.approve(address(vault), shares);
        vm.prank(depositor);
        uint256 requestId = vault.requestRedeem(shares);

        // Get request details
        WeeklyEpochVault.RedemptionRequest memory request = vault.getRequest(requestId);
        uint256 epochEnd = vault.getEpochEnd(request.epochId);

        // Warp to after epoch ends
        vm.warp(epochEnd + 1);

        // Update NAV
        vm.prank(navUpdater);
        vault.updateNAV(1000 * ONE_USDC_E);

        // Settle epoch
        uint256 availableAssets = 100 * ONE_USDC_E;
        vm.prank(settler);
        vault.settleEpoch(request.epochId, availableAssets);

        // Record balance before claim
        uint256 balanceBefore = mockAsset.balanceOf(depositor);

        // Claim the request
        vm.prank(depositor);
        vault.claim(requestId);

        // Verify assets were transferred
        uint256 balanceAfter = mockAsset.balanceOf(depositor);
        assertEq(balanceAfter - balanceBefore, shares, "Should receive claimable assets");

        // Verify request status is Claimed
        request = vault.getRequest(requestId);
        assertEq(uint256(request.status), uint256(WeeklyEpochVault.RequestStatus.Claimed), "Status should be Claimed");
        assertEq(request.claimableAssets, 0, "Claimable assets should be cleared");
    }

