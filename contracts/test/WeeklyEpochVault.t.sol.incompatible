    /// @notice Test getSettlementStatus returns correct data
    function testGetSettlementStatus() public {
        uint256 shares = 100 * ONE_USDC_E;
        
        mockAsset.mint(depositor, shares);
        vm.prank(depositor);
        mockAsset.approve(address(vault), shares);
        vm.prank(depositor);
        uint256 requestId = vault.requestRedeem(shares);
        
        WeeklyEpochVault.RedemptionRequest memory request = vault.getRequest(requestId);
        uint256 epochEnd = vault.getEpochEnd(request.epochId);
        
        vm.warp(epochEnd + 1);
        
        vm.prank(navUpdater);
        vault.updateNAV(1000 * ONE_USDC_E);
        
        // Before settlement
        (WeeklyEpochVault.SettlementStatus memory status, uint256 nextIndex, uint256 totalRequests) = 
            vault.getSettlementStatus(request.epochId);
        
        assertEq(totalRequests, 1, "Should have 1 request");
        assertEq(status.totalShares, 0, "Should have 0 shares before settlement");
        assertFalse(status.settled, "Should not be settled yet");
        
        // After settlement
        uint256 availableAssets = 100 * ONE_USDC_E;
        vm.prank(settler);
        vault.settleEpoch(request.epochId, availableAssets);
        
        (status, nextIndex, totalRequests) = vault.getSettlementStatus(request.epochId);
        
        assertEq(totalRequests, 1, "Should still have 1 request");
        assertEq(status.totalShares, shares, "Should track total shares");
        assertEq(status.availableAssets, availableAssets, "Should track available assets");
        assertTrue(status.settled, "Should be settled");
    }

