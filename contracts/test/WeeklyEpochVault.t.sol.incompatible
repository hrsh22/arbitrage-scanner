    /// @notice Test rollover of partially settled request
    function testRolloverUnsettledPartiallySettledRequest() public {
        uint256 shares = 100 * ONE_USDC_E;

        // Create a redemption request
        mockAsset.mint(depositor, shares);
        vm.prank(depositor);
        mockAsset.approve(address(vault), shares);
        vm.prank(depositor);
        uint256 requestId = vault.requestRedeem(shares);

        // Get request details
        WeeklyEpochVault.RedemptionRequest memory request = vault.getRequest(requestId);
        uint256 epochEnd = vault.getEpochEnd(request.epochId);

        // Warp to after epoch ends
        vm.warp(epochEnd + 1);

        // Update NAV
        vm.prank(navUpdater);
        vault.updateNAV(1000 * ONE_USDC_E);

        // Settle with only 50% of required assets (pro-rata settlement)
        uint256 availableAssets = 50 * ONE_USDC_E;
        vm.prank(settler);
        vault.settleEpoch(request.epochId, availableAssets);

        // Verify request is settled with partial claimable amount
        request = vault.getRequest(requestId);
        assertEq(request.claimableAssets, 50 * ONE_USDC_E, "Should have 50% claimable");

        // Rollover the unfilled portion
        vm.prank(depositor);
        uint256 newRequestId = vault.rolloverUnsettled(requestId);

        // Verify old request is now Claimed
        request = vault.getRequest(requestId);
        assertEq(uint256(request.status), uint256(WeeklyEpochVault.RequestStatus.Claimed), "Old request should be Claimed");
        assertEq(request.claimableAssets, 0, "Old request claimable should be cleared");

        // Verify new rollover request
        WeeklyEpochVault.RedemptionRequest memory newRequest = vault.getRequest(newRequestId);
        assertEq(newRequest.user, depositor, "New request should have same user");
        assertEq(newRequest.shares, 50 * ONE_USDC_E, "New request should have unfilled shares");
        assertEq(newRequest.epochId, request.epochId + 1, "New request should be in next epoch");
        assertEq(uint256(newRequest.status), uint256(WeeklyEpochVault.RequestStatus.Pending), "New request should be Pending");
    }

